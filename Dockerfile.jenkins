# Jenkins CI local sobre Docker. Python del sistema puede ser 3.13;
# entrenamiento y Docker de inferencia están fijados en Python 3.11.
FROM jenkins/jenkins:lts-jdk21
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv python3-pip && rm -rf /var/lib/apt/lists/*
USER jenkins
